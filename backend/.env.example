# Server
PORT=5000
NODE_ENV=production

# Database
USE_MOCK_DB=false
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/brews-memories?retryWrites=true&w=majority

# JWT secret for admin authentication (generate a secure random string)
JWT_SECRET=YourSuperSecretKeyHere-change-in-production-min-32-chars

# Admin seed credentials
ADMIN_EMAIL=brewsandmemoriescafe@gmail.com
ADMIN_PASSWORD=Brews&MemoriesCafe!@2025

# CORS: comma-separated allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting: requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── WhatsApp Notifications (Twilio) ───────────────────────────────────────────
# Get these from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio WhatsApp sandbox FROM number (use this during testing)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your café WhatsApp number — gets an alert on every new order
# Format: country code + number, no spaces e.g. 916361679241
NOTIFY_WHATSAPP_PHONE=916361679241

# ── Email Notifications (Brevo HTTPS API & Fallbacks) ──────────────────────────
# Primary: Brevo Transactional Email HTTPS API (Recommended for production on Render)
# Generated from: Brevo Dashboard -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
EMAIL_FROM=orders@themorascafe.in
EMAIL_FROM_NAME=THE MORAS CAFE
EMAIL_REPLY_TO=orders@themorascafe.in

# Secondary Fallback: Google Apps Script HTTPS Proxy (bypasses Render SMTP port blocks)
GMAIL_PROXY_URL=https://script.google.com/macros/s/AKfycbx.../exec
GMAIL_PROXY_TOKEN=your_secure_proxy_secret_token

# Tertiary Fallback: Direct Gmail SMTP (used locally or if proxy/Brevo unset)
# The Gmail address that sends order confirmation emails
GMAIL_USER=brewsandmemoriescafe@gmail.com
# Gmail App Password (NOT your regular password — see setup guide)
# myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Total number of ordering tables configured in the café
TOTAL_TABLES=5

