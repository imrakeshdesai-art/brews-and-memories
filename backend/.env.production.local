# Production Environment Configuration for Local Testing
NODE_ENV=production
PORT=5000

# Database (using mock mode for testing without MongoDB)
USE_MOCK_DB=false
MONGODB_URI=mongodb+srv://placeholder:placeholder@cluster.mongodb.net/brews-memories

# JWT Secret (minimum 32 characters - this is for testing only!)
JWT_SECRET=testing-secret-key-must-be-32-characters-long-1234567890

# Admin Credentials
ADMIN_EMAIL=brewsandmemoriescafe@gmail.com
ADMIN_PASSWORD=Brews&MemoriesCafe!@2025

# CORS Configuration (localhost for testing)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TOTAL_TABLES=5
