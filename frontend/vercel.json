{
  "redirects": [
    {
      "source": "/",
      "destination": "https://themorascafe.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://themorascafe.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
